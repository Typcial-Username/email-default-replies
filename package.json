  "main": "dist/background.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Typcial-Username/email-default-replies.git"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
