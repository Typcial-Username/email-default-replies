{
  "name": "Email Default Responses",
  "description": "Add default responses to your email to increase productivity",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "src/images/icons/16.png",
    "48": "src/images/icons/48.png",
    "128": "src/images/icons/128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Email Default Responses"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
		    "*://outlook.office365.com/*",
        "*://mail.yahoo.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "*://outlook.live.com/*",
    "*://outlook.office.com/*",
    "*://mail.yahoo.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "email-default-responses@leviterry.dev",
      "strict_min_version": "102.0"
    }
  }
}
